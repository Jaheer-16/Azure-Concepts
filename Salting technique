OR

from pyspark.sql import functions as F

df = orders.withColumn("partition_id", F.spark_partition_id())

grpby = (
    df.groupBy("partition_id")
    .agg(F.count("*").alias("total_rows"))
    .orderBy(F.col("total_rows").desc())
)

grpby.show()


